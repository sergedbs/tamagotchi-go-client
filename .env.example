# Copy to .env.local (ignored). Server-side only: never prefix with VITE_.
# Fixed Gateway upstream for the Vite dev/preview proxy. /api is removed once.
GATEWAY_UPSTREAM=http://127.0.0.1:3000

# Optional: a deployment-specific runtime config (for example with browser push)
# served as /client-config.json instead of public/client-config.json. Keep it in
# an ignored path, such as .local/client-config.json. See client-config.example.json.
# CLIENT_CONFIG=.local/client-config.json

# Optional exact tunnel hostnames, comma-separated (no protocol or path).
DEV_ALLOWED_HOSTS=
